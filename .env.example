# Copie este archivo como .env (cp .env.example .env). El .env nunca se sube al repositorio.

# Puerto HTTP de la API.
SERVER_PORT=8080

# Nombre de la base de datos local; debe coincidir con el final de DB_URL.
DB_NAME=inventario

# URL JDBC de la base de datos (local: el servicio "db" de docker-compose).
DB_URL=jdbc:postgresql://db:5432/inventario

# Usuario y contraseña de la base de datos. Cámbielos; nunca use estos valores en producción.
DB_USERNAME=inventario_app
DB_PASSWORD=cambie_esta_contrasena

# URL de la API de Notificaciones del Equipo 5 (local: el simulador WireMock).
NOTIFICACIONES_URL=http://wiremock:8080

# API Key de Inventario ante la API de Notificaciones (la entrega el Equipo 5).
NOTIFICACIONES_API_KEY=clave_de_ejemplo_no_real

# API Key de cada sistema cliente con su rol (FABRICACION, NOTIFICACIONES, EQUIPO). Cambie los valores y entregue
# cada clave solo al equipo que la usa. La del Equipo 4 se usa en Swagger UI con el botón Authorize.
API_KEYS=clave-fabricacion-cambiar:FABRICACION,clave-notificaciones-cambiar:NOTIFICACIONES,clave-equipo-cambiar:EQUIPO

# Máximo de peticiones por minuto de cada cliente (rate limit).
RATE_LIMIT_PER_MINUTE=60